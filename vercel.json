{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    { "source": "/zones/:city(tours|joue-les-tours|amboise|saint-cyr-sur-loire|montlouis-sur-loire|chambray-les-tours|saint-avertin|ballan-mire|fondettes|la-riche|saint-pierre-des-corps|veigne|montbazon|monts|vouvray|rochecorbon|luynes|azay-le-rideau){/}?", "destination": "/zones/elagueur-:city/", "permanent": true },
    { "source": "/zones/:city(veretz|langeais|chinon|loches|blere){/}?", "destination": "/zones/elagueur-indre-et-loire/", "permanent": true },
    { "source": "/galerie{/}?", "destination": "/a-propos/", "permanent": true },
    { "source": "/urgence{/}?", "destination": "/elagueur-urgence/", "permanent": true },
    { "source": "/prix{/}?", "destination": "/blog/prix-elagage-arbre-tarifs-tours/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
