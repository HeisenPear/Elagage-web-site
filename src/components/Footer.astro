---
/**
 * Pied de page : coordonnées complètes (NAP identique partout), liens vers
 * toutes les prestations et toutes les communes (maillage interne SEO local).
 */
import Icon from '@/components/ui/Icon.astro';
import GoogleRating from '@/components/ui/GoogleRating.astro';
import { siteConfig, getPhoneLink, getEmailLink } from '@/data/siteConfig';
import { servicePages } from '@/data/servicePages';
import { cityPages } from '@/data/cityPages';

const b = siteConfig.business;
const year = new Date().getFullYear();
const cities = cityPages.filter((c) => c.slug !== 'elagueur-indre-et-loire');
---

<footer class="bg-forest text-white/80">
  <div class="container-custom py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display font-bold text-white text-xl mb-3">{b.name}</p>
      <p class="text-sm leading-relaxed mb-5">
        Élagueur grimpeur à Tours et en Indre-et-Loire. Élagage, abattage, dessouchage, taille de haies. Gérant : {b.founder}.
      </p>
      <a href={getPhoneLink()} data-cta="footer" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-accent text-forest font-extrabold text-lg">
        <Icon name="phone" class="w-5 h-5" /> {b.phoneDisplay}
      </a>
      <p class="text-xs text-white/60 mt-2">{b.hours.display}</p>
      <GoogleRating tone="dark" class="mt-4" />
    </div>

    <nav aria-label="Prestations">
      <p class="font-bold text-white mb-3">Prestations</p>
      <ul class="space-y-2 text-sm">
        {servicePages.map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-white hover:underline">{s.name}</a></li>)}
        <li><a href="/elagueur-urgence/" class="hover:text-white hover:underline">Urgence arbre / tempête</a></li>
      </ul>
    </nav>

    <nav aria-label="Communes desservies">
      <p class="font-bold text-white mb-3">Communes desservies</p>
      <ul class="grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
        {cities.map((c) => <li><a href={`/zones/${c.slug}/`} class="hover:text-white hover:underline">{c.name}</a></li>)}
      </ul>
      <a href="/zones/" class="inline-block mt-3 text-sm text-accent hover:underline">Toute la zone d'intervention →</a>
    </nav>

    <div>
      <p class="font-bold text-white mb-3">Coordonnées</p>
      <address class="not-italic text-sm space-y-3">
        <p class="flex gap-2"><Icon name="pin" class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" /><span>{b.name}<br />{b.address.street}<br />{b.address.postalCode} {b.address.city}</span></p>
        <p class="flex gap-2"><Icon name="phone" class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" /><a href={getPhoneLink()} data-cta="footer-coordonnees" class="hover:text-white">{b.phoneDisplay}</a></p>
        <p class="flex gap-2"><Icon name="mail" class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" /><a href={getEmailLink()} class="hover:text-white break-all">{b.email}</a></p>
        <p class="flex gap-2"><Icon name="clock" class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" /><span>{b.hours.display}</span></p>
      </address>
      <ul class="mt-5 space-y-1.5 text-sm">
        <li><a href="/a-propos/" class="hover:text-white hover:underline">Qui sommes-nous</a></li>
        <li><a href="/blog/" class="hover:text-white hover:underline">Conseils élagage</a></li>
        <li><a href="/contact/" class="hover:text-white hover:underline">Contact et devis</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-custom py-5 flex flex-col md:flex-row gap-2 justify-between text-xs text-white/55">
      <p>© {year} {b.name} — {b.legal.name}, {b.legal.form.toLowerCase()}</p>
      <p class="flex gap-4">
        <a href="/mentions-legales/" class="hover:text-white">Mentions légales</a>
        <a href="/mentions-legales/#cookies" class="hover:text-white">Cookies</a>
      </p>
    </div>
  </div>
</footer>
