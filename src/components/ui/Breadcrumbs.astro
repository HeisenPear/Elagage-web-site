---
/** Fil d'Ariane visible (les données structurées sont générées par la page). */
interface Props {
  items: { name: string; url: string }[];
  tone?: 'light' | 'dark';
}
const { items, tone = 'dark' } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class:list={['text-sm mb-6', tone === 'dark' ? 'text-white/70' : 'text-neutral-gray']}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < items.length - 1 ? (
          <a href={item.url} class="hover:underline">{item.name}</a>
        ) : (
          <span aria-current="page" class={tone === 'dark' ? 'text-white' : 'text-forest font-medium'}>{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
