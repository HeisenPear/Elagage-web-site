---
/**
 * Hero de la page d'accueil : vraie photo de chantier, promesse claire,
 * appel en CTA principal, SMS photo en alternative (pour ceux qui n'osent pas appeler).
 */
import Icon from '@/components/ui/Icon.astro';
import CallButton from '@/components/ui/CallButton.astro';
import GoogleRating from '@/components/ui/GoogleRating.astro';
import { siteConfig, getSmsLink } from '@/data/siteConfig';

const b = siteConfig.business;
const chips = [
  'Devis gratuit sur photo',
  b.insuranceShort,
  'Travail en grimpe',
  'Chantier nettoyé',
  b.foundedYear ? `Depuis ${b.foundedYear}` : null,
].filter(Boolean) as string[];
---

<section class="relative isolate overflow-hidden bg-forest text-white">
  <img
    src="/images/chantiers/elagueur-grimpeur-demontage-conifere.webp"
    srcset="/images/chantiers/elagueur-grimpeur-demontage-conifere-800.webp 800w, /images/chantiers/elagueur-grimpeur-demontage-conifere.webp 1200w"
    sizes="100vw"
    alt="Élagueur grimpeur encordé en train de démonter un grand conifère"
    width="1200"
    height="742"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 w-full h-full object-cover object-[70%_center]"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-forest/80 via-forest/60 to-forest/90 md:bg-gradient-to-r md:from-forest/95 md:via-forest/80 md:to-forest/30"></div>

  <div class="container-custom py-12 md:py-24 lg:py-28">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2 text-sm font-semibold text-accent mb-4">
        <Icon name="pin" class="w-4 h-4" /> {b.address.city} · Tours · Indre-et-Loire (37)
      </p>
      <h1 class="font-display font-bold leading-[1.08] mb-5 text-[2.1rem] sm:text-5xl lg:text-6xl">
        Élagueur à Tours et en Indre-et-Loire
      </h1>
      <p class="text-lg md:text-xl text-white/90 leading-relaxed mb-7">
        Élagage, abattage, dessouchage et taille de haies. Un arbre qui gêne, qui inquiète ou qui a souffert de la tempête&nbsp;?
        Envoyez-en une photo : Rudy vous répond avec un devis écrit et gratuit.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 mb-3">
        <CallButton size="xl" cta="hero" />
        <a
          href={getSmsLink()}
          data-cta="hero"
          class="lg:hidden inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-white/60 font-bold"
        >
          <Icon name="camera" class="w-5 h-5" /> Envoyer une photo par SMS
        </a>
        <a
          href="#rappel"
          class="hidden lg:inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-white/60 font-bold hover:bg-white hover:text-forest transition-colors"
        >
          Être rappelé
        </a>
      </div>
      <p class="text-sm text-white/75 mb-3">C'est Rudy qui décroche · {b.hours.display}</p>
      <GoogleRating tone="dark" class="mb-7" />

      <ul class="flex flex-wrap gap-2">
        {chips.map((c) => (
          <li class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 border border-white/20 text-sm font-medium">
            <Icon name="tick" class="w-4 h-4 text-accent" /> {c}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
