---
/** Photos de chantiers réels. */
import { realisations } from '@/data/realisations';

interface Props {
  title?: string;
  intro?: string;
}
const {
  title = 'Nos chantiers, en vrai',
  intro = "Pas de photos de banque d'images : ce sont nos interventions chez des particuliers de Touraine.",
} = Astro.props;
---

<section class="py-16 md:py-20 bg-neutral-cream">
  <div class="container-custom">
    <div class="max-w-2xl mb-8">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-forest mb-3">{title}</h2>
      <p class="text-lg text-neutral-black/75">{intro}</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {realisations.map((r) => (
        <figure class="relative overflow-hidden rounded-xl bg-neutral-200 aspect-[3/4]">
          <img src={r.src} alt={r.alt} width={r.width} height={r.height} loading="lazy" decoding="async" class="w-full h-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 p-3 text-sm font-semibold text-white bg-gradient-to-t from-black/75 to-transparent">{r.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
