---
/** Qui intervient chez vous : le visage de l'entreprise (premier levier de confiance). */
import Icon from '@/components/ui/Icon.astro';
import CallButton from '@/components/ui/CallButton.astro';
import { siteConfig, getYearsInBusiness, getReviewsLabel } from '@/data/siteConfig';

interface Props {
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
const b = siteConfig.business;
const years = getYearsInBusiness();

const reviews = getReviewsLabel();
const facts = [
  reviews ? `Noté ${reviews.rating}/5 par ${reviews.count} clients sur Google` : null,
  years ? `Entreprise créée en ${b.foundedYear}` : null,
  b.certification,
  `${b.insurance} — attestation fournie sur demande`,
  'Matériel professionnel : grimpe, rogneuse de souches, broyeur',
  b.paymentInFewTimes ? 'Paiement en plusieurs fois possible sur les gros chantiers' : null,
].filter(Boolean) as string[];
---

<section class="py-16 md:py-20 bg-white">
  <div class="container-custom grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <figure class="rounded-2xl overflow-hidden bg-neutral-200 aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5] max-h-[560px]">
      <img
        src="/images/chantiers/materiel-elagage-stihl.webp"
        alt="Matériel d'élagage professionnel : tronçonneuses Stihl, élagueuse et souffleur, prêts pour un chantier"
        width="540"
        height="1199"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-[center_45%]"
      />
    </figure>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-forest/60 mb-3">Qui intervient chez vous</p>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-forest mb-5">Rudy Capello, élagueur grimpeur à {b.address.city}</h2>
      <p class="text-lg text-neutral-black/80 leading-relaxed mb-4">
        Le numéro du site est celui de Rudy. C'est lui qui répond, qui vient voir votre arbre, qui établit le devis et qui monte dans l'arbre le jour du chantier.
        Pas de plateforme ni de centre d'appels : un seul interlocuteur, du premier appel au nettoyage final.
      </p>
      <ul class="space-y-2.5 mb-7">
        {facts.map((f) => (
          <li class="flex gap-3 text-neutral-black/85">
            <Icon name="tick" class="w-5 h-5 mt-0.5 flex-shrink-0 text-forest" />
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <div class="flex flex-col sm:flex-row gap-3">
        <CallButton size="lg" cta="a-propos-bloc" label={`Appeler Rudy · ${b.phoneDisplay}`} />
        {showLink && (
          <a href="/a-propos/" class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-forest/20 text-forest font-bold hover:border-forest/50">
            En savoir plus <Icon name="arrow" class="w-4 h-4" />
          </a>
        )}
      </div>
    </div>
  </div>
</section>
