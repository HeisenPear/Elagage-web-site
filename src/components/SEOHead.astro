---
/**
 * Balises <head> : title, description, canonical, Open Graph, favicon, JSON-LD.
 */
import { siteConfig } from '@/data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  schema?: object | object[] | null;
  /** Image à précharger (LCP) — uniquement sur les pages qui l'affichent en haut. */
  preloadImage?: string;
}

const {
  title = siteConfig.seo.title,
  description = siteConfig.seo.description,
  ogImage = siteConfig.seo.ogImage,
  ogType = 'website',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
  schema = null,
  preloadImage,
} = Astro.props;

const absoluteOgImage = new URL(ogImage, Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="author" content={siteConfig.business.name} />
<meta name="format-detection" content="telephone=yes" />
<meta name="google-site-verification" content="google5134ab9840b5a242" />

<!-- SEO local -->
<meta name="geo.region" content="FR-37" />
<meta name="geo.placename" content={siteConfig.business.address.city} />
<meta name="geo.position" content={`${siteConfig.business.coordinates.lat};${siteConfig.business.coordinates.lng}`} />
<meta name="ICBM" content={`${siteConfig.business.coordinates.lat}, ${siteConfig.business.coordinates.lng}`} />

<!-- Open Graph (aperçu WhatsApp, Facebook, SMS) -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.business.name} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="fr_FR" />
<meta name="twitter:card" content="summary_large_image" />

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#1E3312" />

<!-- Polices (chargement non bloquant) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" /></noscript>

{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
