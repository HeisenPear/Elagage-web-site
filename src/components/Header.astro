---
/**
 * En-tête fixe : logo, navigation, numéro de téléphone toujours visible.
 * Menu mobile en HTML natif (<details>) : aucun JavaScript à charger.
 */
import Icon from '@/components/ui/Icon.astro';
import { siteConfig, getPhoneLink } from '@/data/siteConfig';
import { servicePages } from '@/data/servicePages';

const navLinks = [
  { name: 'Services', href: '/services/' },
  { name: "Zones d'intervention", href: '/zones/' },
  { name: 'Conseils', href: '/blog/' },
  { name: 'Qui sommes-nous', href: '/a-propos/' },
  { name: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur border-b border-neutral-200">
  <div class="container-custom">
    <div class="flex items-center justify-between h-16 md:h-[76px] gap-4">
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0" aria-label={`${siteConfig.business.name} — accueil`}>
        <img src="/images/logos/logo-112.webp" alt="" class="w-11 h-11 md:w-12 md:h-12 object-contain" width="48" height="48" />
        <span class="leading-tight">
          <span class="block font-display font-bold text-forest text-[15px] md:text-lg">{siteConfig.business.name}</span>
          <span class="block text-[11px] md:text-xs text-neutral-gray">Élagueur · Tours & Indre-et-Loire</span>
        </span>
      </a>

      <nav class="hidden xl:flex items-center gap-7" aria-label="Navigation principale">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-[15px] font-medium transition-colors whitespace-nowrap',
              isActive(link.href) ? 'text-forest underline decoration-accent decoration-2 underline-offset-8' : 'text-neutral-black/75 hover:text-forest',
            ]}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={getPhoneLink()}
          data-cta="header"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-forest font-extrabold hover:bg-accent-hover transition-colors whitespace-nowrap"
        >
          <Icon name="phone" class="w-4 h-4" />
          {siteConfig.business.phoneDisplay}
        </a>

        <details class="xl:hidden relative group">
          <summary class="list-none cursor-pointer w-11 h-11 flex items-center justify-center rounded-lg border border-neutral-200 text-forest" aria-label="Ouvrir le menu">
            <Icon name="menu" class="w-6 h-6 group-open:hidden" />
            <Icon name="close" class="w-6 h-6 hidden group-open:block" />
          </summary>
          <div class="fixed left-0 right-0 top-16 md:top-[76px] bottom-0 bg-white overflow-y-auto border-t border-neutral-200">
            <nav class="container-custom py-6 space-y-1" aria-label="Menu mobile">
              <a href="/" class="block py-3 text-lg font-semibold text-forest border-b border-neutral-100">Accueil</a>
              {navLinks.map((link) => (
                <a href={link.href} class="block py-3 text-lg font-semibold text-forest border-b border-neutral-100">{link.name}</a>
              ))}
              <p class="pt-5 pb-2 text-xs uppercase tracking-wider text-neutral-gray font-semibold">Nos prestations</p>
              <div class="grid grid-cols-2 gap-2">
                {servicePages.map((s) => (
                  <a href={`/services/${s.slug}/`} class="px-3 py-2.5 rounded-lg bg-neutral-cream text-sm font-medium text-forest">{s.shortName}</a>
                ))}
              </div>
              <div class="pt-6 space-y-3">
                <a href={getPhoneLink()} data-cta="menu-mobile" class="flex items-center justify-center gap-2 h-14 rounded-xl bg-accent text-forest font-extrabold text-lg">
                  <Icon name="phone" class="w-5 h-5" /> {siteConfig.business.phoneDisplay}
                </a>
                <p class="text-center text-sm text-neutral-gray">{siteConfig.business.hours.display} · Devis gratuit</p>
              </div>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
<div class="h-16 md:h-[76px]" aria-hidden="true"></div>
