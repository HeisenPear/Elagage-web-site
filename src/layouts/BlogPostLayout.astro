---
/**
 * Article de blog : auteur identifié (Rudy Capello), dates, fil d'Ariane,
 * appel à l'action et liens vers les prestations.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CallButton from '@/components/ui/CallButton.astro';
import Icon from '@/components/ui/Icon.astro';
import { siteConfig, getSmsLink } from '@/data/siteConfig';
import { servicePages } from '@/data/servicePages';
import { getArticleSchema, getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, publishDate, updatedDate, image, category } = entry.data;
const url = `/blog/${entry.slug}/`;
const fmt = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Conseils', url: '/blog/' },
  { name: title, url },
];

const schema = combineSchemas(
  getArticleSchema({ title, description, url, datePublished: publishDate, dateModified: updatedDate }),
  getBreadcrumbSchema(breadcrumbs),
);

// Prestations liées à la catégorie de l'article (maillage interne vers les pages qui convertissent).
const related = servicePages.filter((s) =>
  category === 'abattage' ? ['abattage-arbres', 'dessouchage-arbres'].includes(s.slug)
  : category === 'reglementation' ? ['elagage-arbres', 'abattage-arbres'].includes(s.slug)
  : ['elagage-arbres', 'abattage-arbres', 'taille-haies'].includes(s.slug),
);
---

<BaseLayout title={title.length <= 45 ? `${title} | ${siteConfig.business.name}` : title} description={description} ogType="article" schema={schema}>
  <article>
    <header class="bg-forest text-white">
      <div class="container-custom max-w-3xl py-10 md:py-14">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-5">{title}</h1>
        <p class="text-lg md:text-xl text-white/85 mb-6">{description}</p>
        <div class="flex items-center gap-3 text-sm text-white/75">
          <span class="w-10 h-10 rounded-full bg-accent text-forest font-bold flex items-center justify-center flex-shrink-0" aria-hidden="true">RC</span>
          <p>
            Par <a href="/a-propos/" class="underline text-white">{siteConfig.business.founder}</a>, élagueur grimpeur en Indre-et-Loire<br />
            Publié le <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
            {updatedDate && <> · mis à jour le <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
          </p>
        </div>
      </div>
    </header>

    {image && (
      <div class="container-custom max-w-3xl pt-8">
        <img src={image.src} alt={image.alt} class="w-full rounded-xl" width="1200" height="630" loading="eager" />
      </div>
    )}

    <div class="container-custom max-w-3xl py-10">
      <div class="article-body">
        <slot />
      </div>

      <aside class="mt-14 p-6 md:p-8 rounded-2xl bg-neutral-cream border border-neutral-200">
        <p class="text-2xl font-display font-bold text-forest mb-2">Un doute sur votre arbre ?</p>
        <p class="text-neutral-black/80 mb-5">
          Appelez Rudy ou envoyez-lui une photo : il vous dit ce qu'il ferait, et passe voir l'arbre gratuitement pour un devis écrit.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <CallButton size="lg" cta={`blog-${entry.slug}`} />
          <a href={getSmsLink()} data-cta={`blog-${entry.slug}`} class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-forest/20 text-forest font-bold">
            <Icon name="camera" class="w-5 h-5" /> Photo par SMS
          </a>
        </div>
      </aside>

      <nav class="mt-10" aria-label="Prestations liées">
        <p class="font-bold text-forest mb-3">Nos prestations</p>
        <ul class="flex flex-wrap gap-2">
          {related.map((s) => (
            <li><a href={`/services/${s.slug}/`} class="inline-block px-4 py-2 rounded-lg bg-white border border-neutral-200 text-forest font-medium hover:border-forest/40">{s.name} à Tours</a></li>
          ))}
          <li><a href="/blog/" class="inline-block px-4 py-2 rounded-lg text-forest underline">Tous nos conseils</a></li>
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article-body { color: #1f2a1a; font-size: 1.075rem; line-height: 1.75; }
  .article-body h2 { font-family: 'Space Grotesk', Inter, sans-serif; font-weight: 700; font-size: 1.75rem; line-height: 1.25; color: #1E3312; margin: 2.5rem 0 1rem; }
  .article-body h3 { font-weight: 700; font-size: 1.3rem; color: #1E3312; margin: 2rem 0 0.75rem; }
  .article-body h4 { font-weight: 700; font-size: 1.1rem; color: #1E3312; margin: 1.5rem 0 0.5rem; }
  .article-body p { margin: 0 0 1.1rem; }
  .article-body ul, .article-body ol { margin: 0 0 1.25rem 1.25rem; }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body li { margin: 0.35rem 0; }
  .article-body a { color: #1E3312; text-decoration: underline; text-decoration-color: #A4BD01; text-underline-offset: 3px; }
  .article-body strong { color: #1E3312; }
  .article-body blockquote { border-left: 4px solid #A4BD01; padding-left: 1rem; margin: 1.5rem 0; color: #444; }
  .article-body table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; display: block; overflow-x: auto; }
  .article-body th { background: #1E3312; color: #fff; text-align: left; padding: 0.6rem 0.75rem; }
  .article-body td { border: 1px solid #e2e2dc; padding: 0.6rem 0.75rem; vertical-align: top; }
  .article-body hr { margin: 2rem 0; border-color: #e2e2dc; }
  .article-body img { border-radius: 0.75rem; margin: 1.5rem 0; }
</style>
