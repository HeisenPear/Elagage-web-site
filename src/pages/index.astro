---
/**
 * Page d'accueil — objectif : déclencher l'appel (ou le SMS photo) en moins de 10 secondes.
 * Ordre : promesse + appel → besoin du visiteur → qui intervient → déroulé → preuves → zones → FAQ.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import AboutRudy from '@/components/sections/AboutRudy.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import RealisationsGrid from '@/components/sections/RealisationsGrid.astro';
import ZonesLinks from '@/components/sections/ZonesLinks.astro';
import FaqList from '@/components/sections/FaqList.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/react/ContactForm';
import { siteConfig, getPhoneLink, getReviewsLabel } from '@/data/siteConfig';
import { getBusinessSchema, getFounderSchema, getWebSiteSchema, getFAQSchema, combineSchemas } from '@/utils/schemas';

const schema = combineSchemas(getBusinessSchema(), getFounderSchema(), getWebSiteSchema(), getFAQSchema());

// Le visiteur arrive avec un problème, pas avec un nom de prestation.
const needs = [
  { icon: 'alert' as const, title: 'Un arbre menace ma maison', text: 'Arbre penché, creux, mort ou trop proche de la toiture.', href: '/services/abattage-arbres/' },
  { icon: 'bolt' as const, title: 'Arbre tombé après une tempête', text: 'Mise en sécurité au plus vite : appelez directement.', href: getPhoneLink(), call: true },
  { icon: 'tree' as const, title: 'Mon arbre est trop grand', text: "Trop d'ombre, branches sur le toit ou chez le voisin.", href: '/services/elagage-arbres/' },
  { icon: 'stump' as const, title: 'Il reste une souche', text: 'Rognage sous le niveau du sol, sans pelleteuse.', href: '/services/dessouchage-arbres/' },
  { icon: 'hedge' as const, title: 'Ma haie déborde', text: 'Thuyas, lauriers, grandes haies : taille et évacuation.', href: '/services/taille-haies/' },
  { icon: 'users' as const, title: 'Les branches du voisin dépassent', text: 'Ce que dit la loi et comment régler ça à l\'amiable.', href: '/blog/arbre-voisin-droit-elagage/' },
];

const testimonials = siteConfig.testimonials;
const reviews = getReviewsLabel();
---

<BaseLayout
  title={siteConfig.seo.title}
  description={siteConfig.seo.description}
  schema={schema}
>
  <HeroSection />

  <section class="py-14 md:py-20 bg-white">
    <div class="container-custom">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-forest mb-8 max-w-2xl">Quel est votre besoin ?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        {needs.map((n) => (
          <a
            href={n.href}
            data-cta={n.call ? 'besoin-urgence' : undefined}
            class:list={[
              'group flex gap-4 p-5 rounded-2xl border transition',
              n.call ? 'bg-secondary/10 border-secondary/40 hover:border-secondary' : 'bg-neutral-cream border-neutral-200 hover:border-forest/30',
            ]}
          >
            <span class:list={['w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0', n.call ? 'bg-secondary text-forest' : 'bg-white text-forest']}>
              <Icon name={n.icon} class="w-5 h-5" />
            </span>
            <span>
              <span class="block font-bold text-forest text-lg leading-snug mb-1">{n.title}</span>
              <span class="block text-neutral-black/70 text-[15px] leading-snug">{n.text}</span>
              {n.call && <span class="mt-2 inline-flex items-center gap-1.5 font-extrabold text-forest"><Icon name="phone" class="w-4 h-4" /> {siteConfig.business.phoneDisplay}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <AboutRudy />
  <ProcessSteps />
  <ServicesGrid
    title="Élagage, abattage et entretien d'arbres à Tours"
    intro="Rudy intervient en grimpe, avec le matériel adapté à chaque chantier : cordes de rétention, rogneuse de souches, broyeur."
  />
  <RealisationsGrid />

  {reviews && (
    <section class="py-16 md:py-20 bg-white">
      <div class="container-custom">
        <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-12 p-6 md:p-10 rounded-3xl bg-neutral-cream border border-neutral-200">
          <div class="flex-shrink-0">
            <p class="font-display font-bold text-forest text-6xl leading-none">{reviews.rating}<span class="text-2xl text-forest/50">/5</span></p>
            <p class="text-[#F5B301] text-2xl mt-1" aria-hidden="true">★★★★★</p>
          </div>
          <div class="flex-1">
            <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-2">Noté {reviews.rating}/5 par {reviews.count} clients sur Google</h2>
            <p class="text-neutral-black/75 text-lg">Ponctualité, chantier propre, respect des massifs, rapidité après une tempête : lisez ce que disent les clients de Rudy, directement sur sa fiche Google.</p>
          </div>
          <a href={reviews.url} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-forest text-white font-bold whitespace-nowrap hover:bg-forest-700">
            Lire les avis sur Google <Icon name="arrow" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="py-16 md:py-20 bg-white">
      <div class="container-custom">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-forest mb-8">Ils nous ont fait confiance</h2>
        <div class="grid md:grid-cols-3 gap-5">
          {testimonials.map((t) => (
            <figure class="p-6 rounded-2xl bg-neutral-cream">
              <blockquote class="text-neutral-black/85 leading-relaxed mb-4">« {t.text} »</blockquote>
              <figcaption class="text-sm text-neutral-black/70"><strong class="text-forest">{t.name}</strong> · {t.city} · avis {t.source}</figcaption>
            </figure>
          ))}
        </div>
        {siteConfig.business.googleBusiness.url && (
          <a href={siteConfig.business.googleBusiness.url} rel="noopener" class="mt-6 inline-flex items-center gap-2 font-semibold text-forest underline">Voir tous les avis sur Google</a>
        )}
      </div>
    </section>
  )}

  <ZonesLinks />
  <FaqList items={siteConfig.faq} title="Vos questions, nos réponses" />

  <section id="rappel" class="py-16 md:py-20 bg-neutral-cream scroll-mt-24">
    <div class="container-custom grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-3xl md:text-4xl font-display font-bold text-forest mb-4">Vous préférez être rappelé ?</h2>
        <p class="text-lg text-neutral-black/80 mb-6">
          Laissez votre numéro et votre commune : Rudy vous rappelle pour parler de votre arbre et convenir d'un passage pour le devis gratuit.
        </p>
        <ul class="space-y-2.5 text-neutral-black/85">
          <li class="flex gap-3"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0 mt-0.5" /> 4 champs, 30 secondes</li>
          <li class="flex gap-3"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0 mt-0.5" /> Vos coordonnées ne servent qu'à vous rappeler</li>
          <li class="flex gap-3"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0 mt-0.5" /> Des photos ? Envoyez-les par SMS au {siteConfig.business.phoneDisplay}</li>
        </ul>
      </div>
      <div class="bg-white rounded-2xl shadow-soft p-6 md:p-8">
        <ContactForm client:visible />
      </div>
    </div>
  </section>

  <CtaBand cta="accueil-fin" />
</BaseLayout>
