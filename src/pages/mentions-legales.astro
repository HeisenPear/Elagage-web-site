---
/** Mentions légales, données personnelles et cookies. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/siteConfig';

const b = siteConfig.business;
const h2 = 'text-2xl font-display font-bold text-forest mt-10 mb-3';
---

<BaseLayout title={`Mentions légales | ${b.name}`} description={`Mentions légales, données personnelles et cookies du site ${b.name}.`} noindex={true}>
  <section class="py-12 md:py-16 bg-white">
    <div class="container-custom max-w-3xl text-neutral-black/85 leading-relaxed">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-forest mb-6">Mentions légales</h1>

      <h2 class={h2}>Éditeur du site</h2>
      <p>
        {b.legal.name}, {b.legal.form.toLowerCase()}, exerçant sous le nom commercial « {b.name} »<br />
        Siège : {b.legal.address}<br />
        SIREN {b.siren.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3')} — SIRET {b.siret}<br />
        TVA intracommunautaire : {b.legal.vat}<br />
        Téléphone : <a href={`tel:${b.phone}`} class="underline">{b.phoneDisplay}</a> — E-mail : <a href={`mailto:${b.email}`} class="underline">{b.email}</a>
      </p>
      <p class="mt-3">Directeur de la publication : {b.legal.name}.</p>

      <h2 class={h2}>Hébergement</h2>
      <p>Vercel Inc., 440 N Barranca Avenue #4133, Covina, CA 91723, États-Unis — vercel.com</p>

      {b.legal.mediator && (
        <>
          <h2 class={h2}>Médiation de la consommation</h2>
          <p>
            Conformément à l'article L612-1 du Code de la consommation, vous pouvez recourir gratuitement au médiateur de la consommation :
            {' '}<a href={b.legal.mediator.url} class="underline" rel="noopener">{b.legal.mediator.name}</a>.
          </p>
        </>
      )}

      <h2 class={h2}>Propriété intellectuelle</h2>
      <p>Les textes et photographies de ce site sont la propriété de {b.legal.name}. Toute reproduction sans autorisation écrite est interdite.</p>

      <h2 id="donnees" class={h2}>Données personnelles</h2>
      <p>
        Les informations saisies dans le formulaire « Être rappelé » (nom, téléphone, commune, message) servent uniquement à vous recontacter au sujet de votre demande et à établir un devis.
        Elles sont transmises par e-mail via le service EmailJS, ne sont ni revendues ni utilisées à des fins de prospection, et sont conservées au maximum 3 ans après le dernier contact.
      </p>
      <p class="mt-3">
        Vous pouvez demander l'accès, la rectification ou la suppression de vos données en écrivant à <a href={`mailto:${b.email}`} class="underline">{b.email}</a>.
        En cas de difficulté, vous pouvez saisir la CNIL (cnil.fr).
      </p>

      <h2 id="cookies" class={h2}>Cookies</h2>
      <p>
        La mesure d'audience (Vercel Web Analytics) fonctionne sans cookie et sans donnée permettant de vous identifier.
        Un cookie Google Ads est déposé <strong>uniquement si vous l'acceptez</strong> dans le bandeau : il sert à savoir si une annonce Google vous a amené sur le site et si vous nous avez contactés ensuite. Votre choix est conservé dans votre navigateur.
      </p>
      <button type="button" id="reset-consent" class="mt-4 px-4 py-2 rounded-lg border border-forest text-forest font-semibold hover:bg-neutral-cream">
        Modifier mon choix sur les cookies
      </button>
    </div>
  </section>

  <script is:inline>
    document.getElementById('reset-consent')?.addEventListener('click', function () {
      try { localStorage.removeItem('cookie-consent'); } catch (e) {}
      location.reload();
    });
  </script>
</BaseLayout>
