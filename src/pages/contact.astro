---
/** Contact : appel en premier, SMS photo, puis formulaire de rappel. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CallButton from '@/components/ui/CallButton.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/react/ContactForm';
import { siteConfig, getSmsLink, getEmailLink } from '@/data/siteConfig';
import { getBusinessSchema, getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';

const b = siteConfig.business;
const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
const schema = combineSchemas(
  getBusinessSchema(),
  { '@context': 'https://schema.org', '@type': 'ContactPage', url: new URL('/contact/', Astro.site).href },
  getBreadcrumbSchema(breadcrumbs),
);
---

<BaseLayout
  title={`Contact et devis gratuit – Élagueur Tours | ${b.phoneDisplay}`}
  description={`Devis gratuit pour élagage, abattage, dessouchage ou taille de haies à Tours et en Indre-et-Loire. Appelez Rudy au ${b.phoneDisplay}, envoyez une photo par SMS ou demandez à être rappelé.`}
  schema={schema}
>
  <section class="bg-forest text-white">
    <div class="container-custom py-10 md:py-14 max-w-3xl">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-4">Contact et devis gratuit</h1>
      <p class="text-lg md:text-xl text-white/85">Le plus rapide : appeler. C'est Rudy qui répond ; s'il est dans un arbre, laissez un message, il rappelle dès qu'il redescend.</p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-neutral-cream">
    <div class="container-custom grid lg:grid-cols-5 gap-8">
      <div class="lg:col-span-2 space-y-4">
        <div class="p-6 rounded-2xl bg-white border border-neutral-200">
          <p class="font-bold text-forest text-lg mb-1 flex items-center gap-2"><Icon name="phone" class="w-5 h-5" /> Par téléphone</p>
          <p class="text-neutral-black/75 mb-4">{b.hours.display}</p>
          <CallButton size="lg" full cta="contact" />
        </div>
        <div class="p-6 rounded-2xl bg-white border border-neutral-200">
          <p class="font-bold text-forest text-lg mb-1 flex items-center gap-2"><Icon name="camera" class="w-5 h-5" /> Par SMS, avec une photo</p>
          <p class="text-neutral-black/75 mb-4">Une photo de l'arbre (avec la maison ou une personne pour l'échelle) et votre commune : Rudy vous donne une première idée.</p>
          <a href={getSmsLink()} data-cta="contact" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-forest text-white font-bold">
            Envoyer un SMS au {b.phoneDisplay}
          </a>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-neutral-200 text-[15px] space-y-2">
          <p class="flex gap-2"><Icon name="mail" class="w-5 h-5 text-forest flex-shrink-0" /><a href={getEmailLink()} class="underline break-all">{b.email}</a></p>
          <p class="flex gap-2"><Icon name="pin" class="w-5 h-5 text-forest flex-shrink-0" /><span>{b.address.street}, {b.address.postalCode} {b.address.city}</span></p>
          <p class="flex gap-2"><Icon name="clock" class="w-5 h-5 text-forest flex-shrink-0" /><span>{b.hours.display}</span></p>
        </div>
      </div>

      <div class="lg:col-span-3 p-6 md:p-8 rounded-2xl bg-white shadow-soft">
        <h2 class="text-2xl font-display font-bold text-forest mb-2">Être rappelé</h2>
        <p class="text-neutral-black/75 mb-6">Laissez votre numéro et votre commune, Rudy vous rappelle.</p>
        <ContactForm client:idle />
      </div>
    </div>
  </section>
</BaseLayout>
