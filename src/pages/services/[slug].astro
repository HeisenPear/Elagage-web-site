---
/**
 * Pages services — URL : /services/[slug]/ (mêmes URL que les anciennes pages).
 * Contenu dans servicePages.ts. Aucun prix : devis gratuit sur place.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CallButton from '@/components/ui/CallButton.astro';
import Icon from '@/components/ui/Icon.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import AboutRudy from '@/components/sections/AboutRudy.astro';
import FaqList from '@/components/sections/FaqList.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import ZonesLinks from '@/components/sections/ZonesLinks.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getCollection } from 'astro:content';
import { siteConfig, getSmsLink } from '@/data/siteConfig';
import { getServiceSchema, getFAQSchema, getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';
import type { ServicePage } from '@/data/servicePages';

export async function getStaticPaths() {
  const { servicePages } = await import('@/data/servicePages');
  return servicePages.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: ServicePage;
}
const { service } = Astro.props;
const url = `/services/${service.slug}/`;

const posts = (await getCollection('blog')).filter((p) => service.relatedPosts.includes(p.slug));

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url },
];

const schema = combineSchemas(
  getServiceSchema(service.name, service.description, service.slug),
  getFAQSchema(service.faq),
  getBreadcrumbSchema(breadcrumbs),
);
---

<BaseLayout title={service.title} description={service.description} schema={schema}>
  <section class="bg-forest text-white">
    <div class="container-custom py-10 md:py-16 grid lg:grid-cols-5 gap-10 items-center">
      <div class:list={[service.image ? 'lg:col-span-3' : 'lg:col-span-5 max-w-3xl']}>
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-5">{service.h1}</h1>
        <p class="text-lg md:text-xl text-white/85 mb-7">{service.lead}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <CallButton size="xl" cta={`service-${service.slug}`} />
          <a href={getSmsLink()} data-cta={`service-${service.slug}`} class="lg:hidden inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-white/60 font-bold">
            <Icon name="camera" class="w-5 h-5" /> Photo par SMS
          </a>
        </div>
        <p class="mt-3 text-sm text-white/70">Devis gratuit sur place · {siteConfig.business.hours.display}</p>
      </div>
      {service.image && (
        <figure class="lg:col-span-2 rounded-2xl overflow-hidden bg-forest-700 max-h-[420px]">
          <img src={service.image.src} alt={service.image.alt} width={service.image.width} height={service.image.height} fetchpriority="high" class="w-full h-full max-h-[420px] object-cover" />
        </figure>
      )}
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="container-custom grid lg:grid-cols-2 gap-10 lg:gap-16">
      <div>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-5">Quand faire appel à nous ?</h2>
        <ul class="space-y-3">
          {service.signs.map((s) => (
            <li class="flex gap-3 text-lg text-neutral-black/85"><Icon name="alert" class="w-5 h-5 mt-1 text-secondary flex-shrink-0" />{s}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-neutral-cream p-6 md:p-8">
        <h2 class="text-2xl font-display font-bold text-forest mb-5">Ce qui est compris</h2>
        <ul class="space-y-3 mb-6">
          {service.includes.map((i) => (
            <li class="flex gap-3 text-neutral-black/85"><Icon name="tick" class="w-5 h-5 mt-0.5 text-forest flex-shrink-0" />{i}</li>
          ))}
        </ul>
        <p class="text-[15px] text-neutral-black/70">
          Pas de grille tarifaire : chaque arbre est différent. Le prix est fixé par écrit après la visite, sans engagement de votre part.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-neutral-cream">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-8">Nos techniques</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {service.techniques.map((t) => (
          <div class="p-6 rounded-2xl bg-white border border-neutral-200">
            <h3 class="text-lg font-bold text-forest mb-2">{t.title}</h3>
            <p class="text-neutral-black/80 leading-relaxed">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="container-custom max-w-3xl">
      {service.sections.map((sec) => (
        <div class="mb-10 last:mb-0">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-4">{sec.heading}</h2>
          {sec.paragraphs.map((p) => <p class="text-lg text-neutral-black/85 leading-relaxed mb-4">{p}</p>)}
        </div>
      ))}
      <div class="mt-10 p-6 rounded-2xl border-2 border-accent bg-accent/5 flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
        <p class="font-bold text-forest text-lg">Une question sur votre arbre ? Rudy vous répond au téléphone.</p>
        <CallButton size="md" cta={`service-milieu-${service.slug}`} />
      </div>
    </div>
  </section>

  <ProcessSteps />
  <AboutRudy />
  <FaqList items={service.faq} title={`Questions fréquentes — ${service.name.toLowerCase()}`} />

  {posts.length > 0 && (
    <section class="py-14 bg-neutral-cream">
      <div class="container-custom">
        <h2 class="text-2xl font-display font-bold text-forest mb-6">Pour aller plus loin</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {posts.map((p) => (
            <a href={`/blog/${p.slug}/`} class="p-5 rounded-xl bg-white border border-neutral-200 hover:border-forest/30">
              <p class="font-semibold text-forest leading-snug">{p.data.title}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-sm text-forest/70">Lire le conseil <Icon name="arrow" class="w-4 h-4" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <ServicesGrid title="Nos autres prestations" exclude={service.slug} />
  <ZonesLinks title={`${service.name} : communes desservies`} />
  <CtaBand cta={`service-fin-${service.slug}`} />
</BaseLayout>
