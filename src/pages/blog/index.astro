---
/** Index des conseils (blog). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';
import { getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';

const posts = (await getCollection('blog')).sort(
  (a, b) => (b.data.updatedDate ?? b.data.publishDate).valueOf() - (a.data.updatedDate ?? a.data.publishDate).valueOf(),
);

const labels: Record<string, string> = {
  elagage: 'Élagage',
  abattage: 'Abattage',
  conseils: 'Conseils',
  reglementation: 'Réglementation',
  saisonnier: 'Saison',
};

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'Conseils', url: '/blog/' },
];
const schema = combineSchemas(
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `Conseils élagage – ${siteConfig.business.name}`,
    url: new URL('/blog/', Astro.site).href,
    publisher: { '@id': new URL('/#organization', Astro.site).href },
  },
  getBreadcrumbSchema(breadcrumbs),
);
---

<BaseLayout
  title={`Conseils élagage, abattage et réglementation à Tours | ${siteConfig.business.name}`}
  description="Période d'élagage, arbre dangereux, droits entre voisins, réglementation à Tours, prix d'un élagage : les conseils d'un élagueur grimpeur d'Indre-et-Loire."
  schema={schema}
>
  <section class="bg-forest text-white">
    <div class="container-custom py-10 md:py-14 max-w-3xl">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-4">Conseils d'élagueur</h1>
      <p class="text-lg md:text-xl text-white/85">Réglementation, bonnes périodes, arbres dangereux, voisinage : des réponses claires, rédigées par {siteConfig.business.founder}.</p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-neutral-cream">
    <div class="container-custom grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="group flex flex-col p-6 rounded-2xl bg-white border border-neutral-200 hover:border-forest/30 hover:shadow-soft transition">
          <span class="text-xs font-semibold uppercase tracking-wider text-forest/60 mb-2">{labels[post.data.category]}</span>
          <h2 class="text-xl font-bold text-forest leading-snug mb-3">{post.data.title}</h2>
          <p class="text-neutral-black/75 text-[15px] leading-relaxed mb-4 flex-1">{post.data.description}</p>
          <span class="inline-flex items-center gap-1.5 font-semibold text-forest">Lire <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" /></span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand cta="blog-index" />
</BaseLayout>
