---
/**
 * Pages villes — SEO local. URL : /zones/elagueur-[ville]/
 * Contenu propre à chaque commune (cityPages.ts) + blocs communs de confiance.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CallButton from '@/components/ui/CallButton.astro';
import Icon from '@/components/ui/Icon.astro';
import GoogleRating from '@/components/ui/GoogleRating.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import AboutRudy from '@/components/sections/AboutRudy.astro';
import FaqList from '@/components/sections/FaqList.astro';
import ZonesLinks from '@/components/sections/ZonesLinks.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { siteConfig, getSmsLink } from '@/data/siteConfig';
import { getCityBusinessSchema, getFAQSchema, getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';
import type { CityPageData } from '@/data/cityPages';

export async function getStaticPaths() {
  const { cityPages } = await import('@/data/cityPages');
  return cityPages.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

interface Props {
  city: CityPageData;
}
const { city } = Astro.props;
const url = `/zones/${city.slug}/`;
const isDepartment = city.slug === 'elagueur-indre-et-loire';
const title = isDepartment
  ? "Élagueur en Indre-et-Loire (37) : élagage, abattage | Devis gratuit"
  : `Élagueur ${city.name} (${city.postalCode}) : élagage, abattage${city.name.length <= 14 ? ', dessouchage' : ''}`;

// FAQ de la ville + 2 questions générales utiles partout (prix, urgence).
const faq = [
  ...city.faq,
  siteConfig.faq[0],
  siteConfig.faq[2],
];

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: "Zones d'intervention", url: '/zones/' },
  { name: `Élagueur ${city.name}`, url },
];

const schema = combineSchemas(
  getCityBusinessSchema(city.name, url),
  getFAQSchema(faq),
  getBreadcrumbSchema(breadcrumbs),
);
---

<BaseLayout title={title} description={city.description} schema={schema}>
  <section class="bg-forest text-white">
    <div class="container-custom py-10 md:py-16">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 text-sm font-semibold text-accent mb-3">
          <Icon name="pin" class="w-4 h-4" /> {isDepartment ? 'Tout le département' : `${city.name} (${city.postalCode})`}
        </p>
        <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-5">{city.h1}</h1>
        <p class="text-lg md:text-xl text-white/85 mb-7">
          Élagage, abattage, dessouchage et taille de haies {isDepartment ? 'en Indre-et-Loire' : `à ${city.name}`}.
          Rudy se déplace gratuitement pour voir l'arbre et vous remettre un devis écrit.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <CallButton size="xl" cta={`ville-${city.slug}`} />
          <a href={getSmsLink(`Bonjour, je souhaite un devis à ${city.name}. Voici une photo de l'arbre.`)} data-cta={`ville-${city.slug}`} class="lg:hidden inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-white/60 font-bold">
            <Icon name="camera" class="w-5 h-5" /> Photo par SMS
          </a>
        </div>
        <p class="mt-3 text-sm text-white/70">C'est Rudy qui décroche · {siteConfig.business.hours.display}</p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="container-custom grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2 prose-local">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-5">
          {isDepartment ? 'Élagueur dans toute l\'Indre-et-Loire' : `Votre élagueur à ${city.name}`}
        </h2>
        <p class="text-lg text-neutral-black/85 leading-relaxed mb-4">{city.intro}</p>
        <p class="text-lg text-neutral-black/85 leading-relaxed mb-8" set:html={city.specificContent} />

        <h3 class="text-xl font-bold text-forest mb-3">Arbres que nous traitons le plus souvent {isDepartment ? 'dans le département' : `à ${city.name}`}</h3>
        <ul class="grid sm:grid-cols-2 gap-2 mb-8">
          {city.treeTypes.map((t) => (
            <li class="flex gap-2.5 items-start text-neutral-black/85"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0 mt-0.5" />{t}</li>
          ))}
        </ul>

        <h3 class="text-xl font-bold text-forest mb-3">{isDepartment ? 'Principales villes couvertes' : `Secteurs desservis à ${city.name}`}</h3>
        <ul class="flex flex-wrap gap-2">
          {city.neighborhoods.map((n) => (
            <li class="px-3 py-1.5 rounded-lg bg-neutral-cream border border-neutral-200 text-sm text-forest">{n}</li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-24 h-fit rounded-2xl bg-neutral-cream border border-neutral-200 p-6">
        <p class="font-bold text-forest text-lg mb-1">Devis gratuit {isDepartment ? '' : `à ${city.name}`}</p>
        <p class="text-neutral-black/75 text-[15px] mb-3">Appelez ou envoyez une photo de l'arbre : Rudy vous répond directement.</p>
        <GoogleRating class="mb-5" />
        <CallButton size="lg" full cta={`ville-encart-${city.slug}`} />
        <a href={getSmsLink(`Bonjour, je souhaite un devis à ${city.name}. Voici une photo de l'arbre.`)} data-cta={`ville-encart-${city.slug}`} class="mt-3 w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border-2 border-forest/20 text-forest font-bold">
          <Icon name="camera" class="w-5 h-5" /> Photo par SMS
        </a>
        <ul class="mt-5 space-y-2 text-[15px] text-neutral-black/80">
          <li class="flex gap-2"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0" /> Déplacement et devis gratuits</li>
          <li class="flex gap-2"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0" /> {siteConfig.business.insuranceShort}</li>
          <li class="flex gap-2"><Icon name="tick" class="w-5 h-5 text-forest flex-shrink-0" /> Branches évacuées, chantier propre</li>
        </ul>
      </aside>
    </div>
  </section>

  <ServicesGrid title={isDepartment ? 'Nos prestations en Indre-et-Loire' : `Nos prestations à ${city.name}`} />
  <ProcessSteps />
  <AboutRudy />
  <FaqList items={faq} title={isDepartment ? 'Questions fréquentes' : `Questions fréquentes — élagage à ${city.name}`} />
  <ZonesLinks title="Autres communes desservies" current={city.slug} />
  <CtaBand title={isDepartment ? 'Besoin d\'un élagueur en Indre-et-Loire ?' : `Besoin d'un élagueur à ${city.name} ?`} cta={`ville-fin-${city.slug}`} />
</BaseLayout>
