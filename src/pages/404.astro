---
/** Page 404 : renvoie vers l'appel et les pages principales. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallButton from '@/components/ui/CallButton.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import { siteConfig } from '@/data/siteConfig';
---

<BaseLayout title={`Page introuvable | ${siteConfig.business.name}`} description="Cette page n'existe plus. Retrouvez nos prestations d'élagage à Tours ou appelez directement." noindex={true}>
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom max-w-2xl text-center">
      <p class="font-display text-7xl font-bold text-forest/15 mb-2">404</p>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-forest mb-4">Cette page n'existe plus</h1>
      <p class="text-lg text-neutral-black/75 mb-8">Elle a peut-être été déplacée. Le plus simple : appelez, ou repartez de l'accueil.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <CallButton size="lg" cta="404" />
        <a href="/" class="inline-flex items-center justify-center px-6 py-4 rounded-xl border-2 border-forest/20 text-forest font-bold">Retour à l'accueil</a>
      </div>
    </div>
  </section>
  <ServicesGrid title="Nos prestations" />
</BaseLayout>
