---
/** Zones d'intervention : hub vers toutes les pages communes. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CallButton from '@/components/ui/CallButton.astro';
import Icon from '@/components/ui/Icon.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { siteConfig } from '@/data/siteConfig';
import { cityPages } from '@/data/cityPages';
import { getBusinessSchema, getBreadcrumbSchema, combineSchemas } from '@/utils/schemas';

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: "Zones d'intervention", url: '/zones/' },
];
const schema = combineSchemas(getBusinessSchema(), getBreadcrumbSchema(breadcrumbs));
const communes = cityPages.filter((c) => c.slug !== 'elagueur-indre-et-loire');
const linkedNames = new Set(cityPages.map((c) => c.name));
const others = siteConfig.serviceArea.cities.filter((c) => !linkedNames.has(c));
---

<BaseLayout
  title="Zones d'intervention : élagueur à Tours et en Indre-et-Loire (37)"
  description={`Élagueur intervenant à Tours, Joué-lès-Tours, Saint-Avertin, Veigné, Amboise, Montlouis et dans un rayon de ${siteConfig.serviceArea.radius} km. Trouvez votre commune et appelez pour un devis gratuit.`}
  schema={schema}
>
  <section class="bg-forest text-white">
    <div class="container-custom py-10 md:py-16 max-w-3xl">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl md:text-5xl font-display font-bold leading-tight mb-5">Zones d'intervention autour de Tours</h1>
      <p class="text-lg md:text-xl text-white/85 mb-7">
        Basés à {siteConfig.business.address.city}, nous intervenons dans toute la métropole de Tours et dans un rayon d'environ {siteConfig.serviceArea.radius} km en Indre-et-Loire.
      </p>
      <CallButton size="xl" cta="zones-hub" />
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-forest mb-8">Choisissez votre commune</h2>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {communes.map((c) => (
          <li>
            <a href={`/zones/${c.slug}/`} class="flex items-center justify-between gap-3 p-4 rounded-xl bg-neutral-cream border border-neutral-200 hover:border-forest/40">
              <span>
                <span class="block font-bold text-forest">{c.name}</span>
                <span class="block text-sm text-neutral-gray">{c.postalCode}</span>
              </span>
              <Icon name="arrow" class="w-4 h-4 text-forest/60" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10 p-6 rounded-2xl bg-neutral-cream">
        <h2 class="text-xl font-bold text-forest mb-2">Nous intervenons aussi à…</h2>
        <p class="text-neutral-black/80">{others.join(', ')} et dans les communes voisines. <a href="/zones/elagueur-indre-et-loire/" class="underline text-forest">Tout le département</a>.</p>
        <p class="mt-3 text-neutral-black/80">Votre commune n'est pas citée ? Appelez : la réponse est immédiate.</p>
      </div>
    </div>
  </section>

  <CtaBand cta="zones-hub-fin" />
</BaseLayout>
