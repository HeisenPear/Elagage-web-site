# Variables d'environnement (optionnelles)
# Copier ce fichier en .env et remplir les valeurs

# URL du site (pour génération sitemap et schemas)
PUBLIC_SITE_URL=https://votre-domaine.com

# EmailJS - Configuration du formulaire de contact
# Récupérez ces valeurs sur https://dashboard.emailjs.com/
PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Analytics (optionnel)
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads - Suivi des conversions
# PUBLIC_GADS_ID : identifiant du compte (déjà en place : AW-17858152606)
# PUBLIC_GADS_CONV_* : labels des actions de conversion (format AW-XXXXXXXXXX/abc123XYZ)
#   À créer dans Google Ads > Objectifs > Conversions, puis coller le label ici.
#   Tant qu'un label est vide, la conversion correspondante n'est pas envoyée.
PUBLIC_GADS_ID=AW-17858152606
PUBLIC_GADS_CONV_CALL=
PUBLIC_GADS_CONV_FORM=
PUBLIC_GADS_CONV_EMAIL=
